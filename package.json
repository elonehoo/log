{
  "name": "@elonehoo/log-monorepo",
  "type": "module",
  "version": "0.1.1",
  "private": "true",
  "packageManager": "pnpm@12.14.0",
  "description": "Starter template for TypeScript library",
  "author": "Elone Hoo <huchengyea@163.com>",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -C packages/core run build",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag && pnpm -r publish --access public",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev:example": "npm -C example/vanilla run dev",
    "build:example": "npm -C example/vanilla run build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@elonehoo/log": "workspace:*",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "bumpp": "12.3.0",
    "eslint": "10.13.0",
    "pnpm": "12.14.0",
    "rimraf": "6.1.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unbuild": "3.6.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
